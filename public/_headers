# Security headers for statically served assets.
#
# Static files are answered by the Cloudflare Assets route and never reach the Worker,
# so the middleware in src/server/index.ts cannot add headers to them. This file is the
# only thing standing between the HTML document and having no CSP whatsoever.
#
# Keep in sync with the Content-Security-Policy in src/server/index.ts.
#   - no 'unsafe-eval' and no 'unsafe-inline' in script-src (the Preact build needs neither)
#   - 'unsafe-inline' remains in style-src only because a few components set
#     percentage widths through the style prop
#   - font-src 'self': fonts are not loaded from a CDN
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com;
